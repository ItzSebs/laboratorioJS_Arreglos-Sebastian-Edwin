const catalogo = [
  { nombre: "Teclado", precio: 45, categoria: "periféricos", stock: 12 },
  { nombre: "Monitor", precio: 180, categoria: "pantallas", stock: 5 },
  { nombre: "Mouse", precio: 20, categoria: "periféricos", stock: 30 },
  { nombre: "Silla", precio: 150, categoria: "mobiliario", stock: 0 },
];

function productosDisponibles(catalogo) {
  return catalogo.filter(function (p) {
    return p.stock > 0;
  });
}

function nombresPorCategoria(catalogo, categoria) {
  return catalogo
    .filter(function ({ categoria: cat }) {
      return cat === categoria;
    })
    .map(function ({ nombre }) {
      return nombre;
    });
}

function valorTotalInventario(catalogo) {
  return catalogo.reduce(function (acc, p) {
    return acc + p.precio * p.stock;
  }, 0);
}

function productoMasCaro(catalogo) {
  return catalogo.reduce(function (max, p) {
    if (p.precio > max.precio) {
      return p;
    }
    return max;
  }, catalogo[0]);
}

console.log("Disponibles:", productosDisponibles(catalogo));
console.log("Periféricos:", nombresPorCategoria(catalogo, "periféricos"));
console.log("Valor inventario:", valorTotalInventario(catalogo));
console.log("Más caro:", productoMasCaro(catalogo));

/* ---------------- PARTE 4: RETO INTEGRADOR ---------------- */

const ventas = [
  { producto: "Teclado", cantidad: 3, precioUnitario: 45 },
  { producto: "Monitor", cantidad: 1, precioUnitario: 180 },
  { producto: "Mouse", cantidad: 5, precioUnitario: 20 },
  { producto: "Teclado", cantidad: 2, precioUnitario: 45 },
  { producto: "Silla", cantidad: 1, precioUnitario: 150 },
];

function generarReporte(ventas) {
  const agrupado = ventas.reduce(function (acc, v) {
    if (acc[v.producto] === undefined) {
      acc[v.producto] = {
        producto: v.producto,
        cantidadTotal: 0,
        ingresoTotal: 0,
      };
    }
    acc[v.producto].cantidadTotal = acc[v.producto].cantidadTotal + v.cantidad;
    acc[v.producto].ingresoTotal =
      acc[v.producto].ingresoTotal + v.cantidad * v.precioUnitario;
    return acc;
  }, {});

  const resumenPorProducto = Object.values(agrupado);

  const totalVendido = resumenPorProducto.reduce(function (acc, p) {
    return acc + p.ingresoTotal;
  }, 0);

  const numeroTransacciones = ventas.length;

  const ordenado = [...resumenPorProducto];
  ordenado.sort(function (a, b) {
    return b.cantidadTotal - a.cantidadTotal;
  });
  const productoTopVentas = ordenado[0].producto;

  return {
    totalVendido: totalVendido,
    numeroTransacciones: numeroTransacciones,
    productoTopVentas: productoTopVentas,
    resumenPorProducto: resumenPorProducto,
  };
}

console.log(JSON.stringify(generarReporte(ventas), null, 2));

/* ¿Diferencia entre map y forEach?
   map devuelve un arreglo nuevo con cada elemento transformado.
   forEach solo recorre y ejecuta algo, pero no devuelve nada.
   Uso map cuando quiero transformar, y forEach cuando solo
   quiero recorrer.

¿Por qué reduce es el método "más general"?
   Porque con reduce puedo obtener un solo valor a partir de
   todo el arreglo: una suma, un promedio, un objeto o incluso
   otro arreglo. Los demás métodos se pueden escribir usando
   reduce.

 Ejemplo real de arreglo de objetos:
