const temperaturas = [18, 22, 25, 30, 15, 19, 27];

function aFahrenheit(arr) {
  return arr.map(function (c) {
    return (c * 9) / 5 + 32;
  });
}

function diasCalurosos(arr, umbral) {
  return arr.filter(function (t) {
    return t > umbral;
  });
}

function promedio(arr) {
  const suma = arr.reduce(function (acc, n) {
    return acc + n;
  }, 0);
  return suma / arr.length;
}

function temperaturaMaxima(arr) {
  return arr.reduce(function (max, n) {
    if (n > max) {
      return n;
    }
    return max;
  }, arr[0]);
}

function buscarPrimerMayorA(arr, valor) {
  return arr.find(function (n) {
    return n > valor;
  });
}

function ordenarDescendente(arr) {
  const copia = [...arr];
  copia.sort(function (a, b) {
    return b - a;
  });
  return copia;
}

